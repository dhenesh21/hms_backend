# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file.

# Postgres (matches docker-compose.yml service "db")
DATABASE_URL=postgresql://hms_user:hms_password@db:5432/hms_db

# If running the backend locally (outside Docker), use:
# DATABASE_URL=postgresql://hms_user:hms_password@localhost:5432/hms_db

REDIS_URL=redis://redis:6379

# Generate a real secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
